<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CPE.BlazorConnectionStatus</PackageId>
    <!-- 0.x deliberately: the API has never had a consumer. DVMApp is the first, and anything it
         proves awkward can change in 0.10.0 without pretending the break did not happen. 1.0.0 when
         DVMApp is running on it. -->
    <Version>0.9.0</Version>
    <Authors>CPE</Authors>
    <Company>CPE</Company>
    <Description>Connectivity monitoring for Blazor WebAssembly that reports whether the app can actually reach a server, not just whether the network adapter is up. Raises online/offline changes from browser events plus an optional HTTP HEAD probe on an interval, which is what catches "connected to the router, no internet".</Description>
    <PackageTags>blazor;webassembly;offline;offline-first;connectivity;online;network;pwa</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/CP-Engineering/BlazorConnectionStatus</RepositoryUrl>
    <PackageProjectUrl>https://github.com/CP-Engineering/BlazorConnectionStatus</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exposes the JS seam and the fake-friendly members to the test project: the state machine
         is unit-tested without a browser, and the seam is the only thing a browser is needed for. -->
    <InternalsVisibleTo Include="CPE.BlazorConnectionStatus.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

</Project>
